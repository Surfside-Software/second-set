# Local configuration only. Never place provider credentials in client variables.

# Desktop provider: meta by default, baseten, or opencode-go.
SECOND_SET_PROVIDER=meta

# Meta Model API hackathon key. Meta's docs call this MODEL_API_KEY.
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=muse-spark-1.3
META_SEGMENTATION_MODEL=sam-3.1

# Baseten hackathon key. This exact model ID is required by the hackathon grant.
BASETEN_API_KEY=
BASETEN_API_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# OpenCode Go key (oc_sk_...), the variable Pi and OpenCode read, for drawing-set reviews.
# Muse Spark there trains on drawings; see docs/inference.md.
OPENCODE_API_KEY=

# Setup and model reference: docs/inference.md and docs/models.md.

# Optional cloud review connection. Operator setup: docs/cloud-reviews.md.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_ENVIRONMENT=main
SECOND_SET_MODAL_APP=second-set-reviews
SECOND_SET_MODAL_IMAGE=second-set-review-engine:latest
SECOND_SET_MODAL_TIMEOUT_MINUTES=15
# Optional short-lived warm sandbox; omit to avoid idle compute charges.
# SECOND_SET_MODAL_POOL_QUEUE=second-set-review-pool
# Packaged builds: private JSON configuration, permissions 600 on Unix.
# SECOND_SET_MODAL_CONFIG=/absolute/path/to/modal-session.json
